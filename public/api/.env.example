# ==========================================
# Next PHP Mailer - Configuration
# ==========================================

# SMTP Server Host (z.B. mail.hdc-dienstleistungen.de, smtp.ionos.de, smtp.strato.de, smtp.gmail.com)
SMTP_HOST=mail.hdc-dienstleistungen.de

# SMTP Port (465 für SSL/SMTPS, 587 für TLS/STARTTLS, 25 für unverschlüsselt)
SMTP_PORT=465

# SMTP Authentication Credentials
SMTP_USER=info@hdc-dienstleistungen.de
SMTP_PASS=your-mail-password

# Optional: Force encryption ('ssl', 'tls', or leave blank for auto-detection based on port)
SMTP_ENCRYPTION=

# Email Settings
# Die Adresse, an die Kontaktanfragen gesendet werden
RECEIVER_EMAIL=info@hdc-dienstleistungen.de

# Absendername und E-Mail-Adresse
FROM_NAME="HDC Gebäudedienstleistungen Website"
FROM_EMAIL=info@hdc-dienstleistungen.de

# Standard-Betreff
DEFAULT_SUBJECT="Neue Kontaktanfrage über die Website"

# CORS Allowed Origin (* für alle oder https://hdc-dienstleistungen.de)
ALLOWED_ORIGIN=*
